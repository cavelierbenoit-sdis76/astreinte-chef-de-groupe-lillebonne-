<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ASTREINTE SDIS 76</title>

<style>

body{
font-family:Arial;
background:#f3f4f6;
margin:0;
padding:0;
}

header{
background:#c1121f;
color:white;
padding:20px;
}

.container{
padding:20px;
}

.card{
background:white;
padding:20px;
border-radius:10px;
margin-bottom:20px;
box-shadow:0 2px 5px rgba(0,0,0,.1);
}

button{
background:#c1121f;
color:white;
border:none;
padding:10px 15px;
border-radius:5px;
cursor:pointer;
}

.calendar{
display:grid;
grid-template-columns:repeat(7,1fr);
gap:5px;
}

.day{
background:white;
border:1px solid #ddd;
padding:10px;
min-height:60px;
cursor:pointer;
}

.day:hover{
background:#dbeafe;
}

</style>

</head>

<body>

<header>
<h1>ASTREINTE SDIS 76</h1>
<p>Planification 2027</p>
</header>

<div class="container">

<div class="card">
<h2>Statistiques</h2>

<p>Agents : 11</p>

<p>Minima :</p>

<ul>
<li>3 agents : minimum 7 semaines</li>
<li>1 agent : minimum 4 semaines</li>
<li>7 agents : nuits / week-end / fériés</li>
</ul>

</div>

<div class="card">

<h2>Calendrier Janvier 2027</h2>

<div class="calendar">

<div class="day" onclick="affecter(1)">1</div>
<div class="day" onclick="affecter(2)">2</div>
<div class="day" onclick="affecter(3)">3</div>
<div class="day" onclick="affecter(4)">4</div>
<div class="day" onclick="affecter(5)">5</div>
<div class="day" onclick="affecter(6)">6</div>
<div class="day" onclick="affecter(7)">7</div>

</div>

</div>

</div>

<script>

function affecter(jour){

alert(
"Affectation du jour : " + jour
);

}

</script>

</body>
</html>
